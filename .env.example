# Public site URL used for SEO metadata (canonical/OG URLs, sitemap, robots).
# Falls back to https://interviewresources.app in production, localhost otherwise.
NEXT_PUBLIC_SITE_URL=

# Google Analytics Measurement ID (https://analytics.google.com)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Gemini API key (https://aistudio.google.com/apikey)
# Required by the research pipeline (lib/research/gemini.ts).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional in production: include a truncated generated-output preview in
# structured-output failure logs. Development enables this automatically.
RESEARCH_DEBUG=

# Tavily API key (https://app.tavily.com)
# Required by the research pipeline (lib/research/tavily.ts).
TAVILY_API_KEY=

# Postgres connection string (Neon, Supabase, or local).
# Only needed once you run `pnpm db:push` / wire up the app beyond the
# standalone research CLI (pnpm research).
# In production this must be the POOLED endpoint (Neon host contains `-pooler`).
DATABASE_URL=

# Direct, non-pooled Postgres endpoint. Used only by drizzle-kit
# (`pnpm db:migrate`, `db:push`, `db:studio`), which needs session-level
# connections that a transaction-mode pooler cannot provide.
# Required by production deploys and the runtime migration command. Local
# drizzle-kit commands may still fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Auth (better-auth, Google OAuth only) ---
# Random 32+ char string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Full URL for auth callbacks (must match OAuth redirect URIs in Google Cloud)
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client. Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Dodo). Credit packs:
#     Starter $1.49 = 100 credits, Bundle $6.49 = 550, Max $12.49 = 1200. ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ids from the Dodo dashboard, one per credit pack.
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_BUNDLE=
DODO_PRODUCT_ID_MAX=
# Optional comma-separated prior product ids. Webhooks accept them for delayed
# deliveries; checkout never sells them. These map to the old $1/$5/$10 prices.
DODO_LEGACY_PRODUCT_IDS_STARTER=
DODO_LEGACY_PRODUCT_IDS_BUNDLE=
DODO_LEGACY_PRODUCT_IDS_MAX=

# --- Admin ---
# Comma-separated emails allowed into /admin. Fails closed: unset means nobody.
ADMIN_EMAILS=

# --- Cron ---
# Guards /api/cron/reap, which sweeps runs stranded in "running" by a dead
# handler. Configure this as a Production-only Vercel secret and set it by hand
# only to exercise the route locally.
CRON_SECRET=

# --- Not yet wired up — reserved for later milestones (PRD §13) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
